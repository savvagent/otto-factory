# Copy to .env (gitignored). sqlx reads DATABASE_URL at test time, and
# of-server loads this file at startup — dotenvy never overrides a variable
# that is already set, so a real deployment's environment always wins.

DATABASE_URL=postgres://factory:factory@localhost:15433/otto_factory

# ---------------------------------------------------------------- required
# Neither of these has a default, because a wrong value fails silently.

# Public base URL of the console and the authorization server. Every emailed
# link, the OAuth issuer, and both discovery documents are built from it. Get
# it wrong and nothing crashes: links go to an origin that does not exist and
# tokens are minted for an audience nothing accepts, and the first report
# arrives hours later from somebody who cannot sign in.
OF_PUBLIC_URL=http://localhost:8080

# 32 bytes, base64. Encrypts TOTP shared secrets and tracker credentials at
# rest. Generate: openssl rand -base64 32
# There is no default and no generate-on-startup: a key that changes across a
# restart makes every enrolled authenticator unreadable.
OF_ENCRYPTION_KEY=

# ---------------------------------------------------------------- optional
# Defaults shown. A variable that is set but unparseable is a startup error,
# never a silent fallback to the default.

OF_BIND=0.0.0.0:8080

# Canonical public URI of the MCP resource. Tokens are audience-bound to this
# (RFC 8707); a token minted for any other resource is rejected. Defaults to
# $OF_PUBLIC_URL/mcp, which is where this binary serves it.
#OF_RESOURCE_URI=http://localhost:8080/mcp

# The label an authenticator app shows next to the code. Changing it after
# launch orphans every enrolled device.
#OF_TOTP_ISSUER=otto-factory

# GitHub App id for tracker integration. Leave unset when this deployment does
# not offer GitHub issue sync.
#OF_GITHUB_APP_ID=

# PEM-encoded GitHub App private key. Used later to mint installation tokens
# for the configured App; leaving it unset cleanly disables GitHub integration.
# If your secret store only accepts a single-line value, replace each real
# newline in the PEM with a literal `\n` — it is normalized back to a real
# newline on load.
#OF_GITHUB_APP_PRIVATE_KEY=

# Shared secret GitHub signs webhook deliveries with. Task 3 verifies
# X-Hub-Signature-256 against it; leave it unset when GitHub integration is off.
#OF_GITHUB_APP_WEBHOOK_SECRET=

# The GitHub App's URL slug — the name in github.com/apps/<slug>. The console
# builds the "install this App" link from it, so with it unset there is no
# Connect GitHub button rather than a link that 404s.
#OF_GITHUB_APP_SLUG=

# The GitHub App's *user*-to-server OAuth credentials, which are not the same
# thing as OF_GITHUB_APP_PRIVATE_KEY above (that one is server-to-server). The
# console exchanges them for a user token to check that the admin binding an
# installation id actually administers that installation. Without that check,
# any org admin could type any unclaimed installation id and drive another
# customer's GitHub issues, so with these unset the connect flow is not offered.
#
# The App itself must have "Request user authorization (OAuth) during
# installation" enabled, or GitHub's post-install redirect carries no code and
# there is nothing to verify. Nothing here can detect that setting in advance.
#OF_GITHUB_APP_CLIENT_ID=
#OF_GITHUB_APP_CLIENT_SECRET=

# Atlassian OAuth client id and secret for JIRA tracker sync. Leave them unset
# when this deployment does not offer JIRA issue sync.
#OF_JIRA_CLIENT_ID=
#OF_JIRA_CLIENT_SECRET=

# The header a trusted proxy writes the client address into. Empty (the
# default) means the peer address of the connection, which is correct with no
# proxy in front.
#
# Set this ONLY behind a proxy, and only to a header that proxy *overwrites*.
# On Fly.io the answer is fly-client-ip, not x-forwarded-for: fly-proxy appends
# to X-Forwarded-For, so a caller sending its own value arrives left-most and
# every per-IP throttle keys on a value the attacker chose.
#
# Behind Cloudflare it is cf-connecting-ip instead, and only while the origin
# refuses traffic that did not come through Cloudflare — a directly reachable
# origin lets any caller write that header themselves. docs/deploy/cloudflare.md
#OF_CLIENT_IP_HEADER=

# The built console bundle, served with an index.html fallback. Run
# `npm run build` in web/ to produce it.
#OF_STATIC_DIR=web/build

# Extra authorities accepted in the MCP endpoint's Host header, comma
# separated. $OF_PUBLIC_URL's host is always accepted; add others when the
# deployment answers to more than one name. An entry with no port matches any
# port.
#
# Required when anything proxies to this server under a different name — a
# Cloudflare Worker cannot set the Host header on a subrequest, so the origin
# sees its own hostname and refuses every authenticated MCP call while
# unauthenticated ones still answer a correct 401. Name the origin's hostname
# here. docs/deploy/cloudflare.md
#OF_ALLOWED_HOSTS=

# Browser origins accepted on /mcp requests that carry Origin. Empty disables
# the check, which is right for a surface reached by CLI agents.
#OF_ALLOWED_ORIGINS=

# Apply migrations at startup. On by default; sqlx holds a Postgres advisory
# lock for the run, so several replicas starting together is safe.
#OF_RUN_MIGRATIONS=1

# json for a log aggregator, text for a terminal.
#OF_LOG_FORMAT=text

# Refuse billable tool calls once an org on a hard-stop plan is past its
# bucket. Off until milestone 2: usage is recorded from day one, but refusing
# work over a counter nobody has watched in anger yet is a support incident,
# not revenue. Reads keep working even when this is on.
OF_ENFORCE_QUOTAS=0

# Per-crate levels for local work. Nothing here logs a credential: the product
# sends no email, and the one secret a human is handed — an invitation code —
# is returned in the API response to the admin who asked for it, never written
# to a log a deployment retains.
RUST_LOG=info,of_server=debug,of_mcp=debug,of_web=debug
